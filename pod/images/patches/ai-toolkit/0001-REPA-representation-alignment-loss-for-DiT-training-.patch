     def get_transformer_block_names(self) -> Optional[List[str]]:
         return ["transformer_blocks"]
 
+    def get_repa_token_grid(self, latent_height: int, latent_width: int):
+        # 2.1 consumes latents unpatched: one token per latent pixel
+        return latent_height, latent_width
+
+    def get_repa_target_tokens(self, block_output, latents: torch.Tensor) -> torch.Tensor:
+        # the target image closes the joint sequence (reference images and text come
+        # before it), row-major, so its tokens are the last h * w
+        batch_size, _, height, width = latents.shape
+        hidden = block_output[0] if isinstance(block_output, (tuple, list)) else block_output
+        return hidden[:, -height * width :].reshape(batch_size, height, width, -1)
+
     def get_quantization_exclude_modules(self):
         return QwenImage21Transformer2DModel.get_quantization_exclude_modules()
 
