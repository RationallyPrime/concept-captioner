+    def get_repa_token_grid(self, latent_height: int, latent_width: int) -> Optional[Tuple[int, int]]:
+        """Token grid (h, w) of the target image for a latent of this size, or None when
+        the model does not support REPA (toolkit/repa.py). Override together with
+        get_repa_target_tokens."""
+        return None
+
+    def get_repa_target_tokens(self, block_output, latents: torch.Tensor) -> torch.Tensor:
+        """A REPA block's raw forward output (a tensor or a tuple, whatever the block
+        returns) -> the target image's tokens as (B, h, w, D), row-major, with
+        (h, w) = get_repa_token_grid(*latents.shape[-2:]). Reference or condition image
+        tokens and text tokens must not be included."""
+        raise NotImplementedError(f"REPA target tokens are not defined for arch {self.arch}")
+
+    def get_repa_hidden_size(self) -> int:
+        """Width D of the tokens get_repa_target_tokens returns. Read from the transformer
+        config (hidden_size, inner_dim, dim or num_attention_heads * attention_head_dim);
+        override when a model's config has none of them."""
+        config = getattr(unwrap_model(self.model), "config", None)
+        for key in ("hidden_size", "inner_dim", "dim"):
+            value = getattr(config, key, None)
+            if isinstance(value, int) and value > 0:
+                return value
+        heads = getattr(config, "num_attention_heads", None)
+        head_dim = getattr(config, "attention_head_dim", None)
+        if isinstance(heads, int) and isinstance(head_dim, int) and heads > 0 and head_dim > 0:
+            return heads * head_dim
+        raise ValueError(
+            f"Cannot read the transformer width for arch {self.arch}: its config has none of hidden_size, "
+            f"inner_dim, dim or num_attention_heads * attention_head_dim. Override get_repa_hidden_size."
+        )
+
+    def get_repa_blocks(self) -> torch.nn.ModuleList:
+        """The block list REPA indexes: the first name in get_transformer_block_names(),
+        resolved as a dotted path on the unwrapped transformer."""
+        names = self.get_transformer_block_names()
+        if not names:
+            raise ValueError(f"Arch {self.arch} names no transformer block list (get_transformer_block_names)")
+        blocks = unwrap_model(self.model)
+        for part in names[0].split("."):
+            blocks = getattr(blocks, part, None)
+            if blocks is None:
+                raise ValueError(f"Arch {self.arch} has no transformer block list at '{names[0]}'")
+        return blocks
+
     def get_quantization_exclude_modules(self) -> Optional[List[str]]:
         # override in child classes to keep sensitive modules in full precision when
