+# keys a process-level `repa:` block may hold, see toolkit/repa.py
+REPA_KEYS = ('enabled', 'weight', 'block_index', 'encoder', 'encoder_resolution', 'projector', 'projector_dim')
+
+
+class RepaConfig:
+    """The process-level `repa:` block (representation alignment, toolkit/repa.py).
+
+    A key that is not listed in REPA_KEYS is an error, so a misspelt key is not silently ignored.
+    """
+
+    def __init__(self, **kwargs):
+        unknown = [key for key in kwargs if key not in REPA_KEYS]
+        if unknown:
+            raise ValueError(f"unknown repa key: {', '.join(unknown)}. Valid keys: {', '.join(REPA_KEYS)}")
+        # on when the block is present; the UI writes false to switch it off without deleting it
+        self.enabled: bool = kwargs.get('enabled', True)
+        # lambda on the alignment term, the paper's default
+        self.weight: float = kwargs.get('weight', 0.5)
+        # 0-indexed: the OUTPUT of this block of the model's block list (SimpleTuner's convention).
+        # The paper's encoder_depth=8 is the output of the 8th block, i.e. index 7
+        self.block_index: int = kwargs.get('block_index', 8)
+        # any Hugging Face ViT whose last_hidden_state ends with the patch grid (DINOv2, DINOv2 with registers, ...)
+        self.encoder: str = kwargs.get('encoder', 'facebook/dinov2-giant')
+        # the pixel side REPA aims the encoder at; the grid is a whole multiple of the token grid
+        # and the encoder input never exceeds twice this
+        self.encoder_resolution: int = kwargs.get('encoder_resolution', 518)
+        # mlp: the reference projector (Linear-SiLU-Linear-SiLU-Linear); linear: LayerNorm + Linear
+        self.projector: str = kwargs.get('projector', 'mlp')
+        # hidden width of the mlp projector
+        self.projector_dim: int = kwargs.get('projector_dim', 2048)
+
